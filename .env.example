# Porta su cui avviare il server
PORT=3000

# Segreto usato per firmare i cookie di sessione (cambiare in produzione)
SESSION_SECRET=modifica-questo-segreto-in-produzione

# Percorso del file del database SQLite
DB_PATH=./data/crono-service.db

# Configurazione SMTP per l'invio email (OPZIONALE).
# Se questi valori non vengono impostati, le email non vengono inviate
# realmente ma solo simulate e registrate nei log del server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Crono Service <no-reply@cronoservice.it>"
